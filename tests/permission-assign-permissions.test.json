{
  "api": "PUT /api/permission/assign-permissions",
  "cases": [
    {
      "name": "分配角色权限 成功",
      "kind": "http",
      "actor": "admin",
      "method": "PUT",
      "path": "/api/permission/assign-permissions",
      "expect_status": 200,
      "body": {
        "role_id": "AdminRole001",
        "permission_ids": [
          "UsersRead001"
        ]
      },
      "expect_field": {
        "status": 0
      }
    },
    {
      "name": "分配角色权限 参数非法",
      "kind": "http",
      "actor": "admin",
      "method": "PUT",
      "path": "/api/permission/assign-permissions",
      "expect_status": 200,
      "expect_field": {
        "status": 2161
      },
      "body": {}
    }
  ]
}
